{
    "name": "dynamik-dev/marque",
    "description": "A Laravel-native scoped permissions package. Composable, contract-driven authorization that integrates with Gates, Policies, middleware, and Blade.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "permissions",
        "authorization",
        "roles",
        "policy",
        "rbac",
        "scoped-permissions"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32.1",
        "laravel/sanctum": "^4.3.3",
        "orchestra/testbench": "^10.12 || ^11.3",
        "pestphp/pest": "^4.7.8 || ^5.3.2",
        "pestphp/pest-plugin-laravel": "^4.1 || ^5.0.1"
    },
    "autoload": {
        "psr-4": {
            "DynamikDev\\Marque\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DynamikDev\\Marque\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DynamikDev\\Marque\\MarqueServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ],
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --exclude-group=benchmark",
        "test:arch": "vendor/bin/pest --testsuite=Architecture",
        "test:benchmark": "vendor/bin/pest --testsuite=Benchmark",
        "test:pgsql": "DB_CONNECTION=pgsql vendor/bin/pest --exclude-group=benchmark",
        "test:mysql": "DB_CONNECTION=mysql vendor/bin/pest --exclude-group=benchmark",
        "test:all": [
            "@test",
            "@test:pgsql"
        ],
        "test:coverage": "@test --coverage --min=90",
        "test:services": "docker compose up -d --wait",
        "test:down": "docker compose down --volumes"
    },
    "prefer-stable": true
}
